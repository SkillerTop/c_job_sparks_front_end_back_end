# Copy this file to .env.production and replace every CHANGE_ME value.
# Never commit .env.production.

APP_IMAGE_TAG=latest
PUBLIC_ORIGIN=https://sparks.example.com

POSTGRES_DB=c_job_sparks
POSTGRES_USER=c_job_sparks
POSTGRES_PASSWORD=CHANGE_ME_GENERATED_DATABASE_PASSWORD

NODE_ENV=production
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

DATABASE_URL=postgresql://c_job_sparks:CHANGE_ME_GENERATED_DATABASE_PASSWORD@db:5432/c_job_sparks
DATABASE_SSL=disable
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

MIGRATIONS_DIR=/app/server/migrations
MEDIA_ROOT=/app/server/data/media

COOKIE_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_COOKIE_NAME=c_job_sparks_session
SESSION_TTL_HOURS=168
TRUST_PROXY=true

CORS_ORIGINS=https://sparks.example.com
FRONTEND_ORIGIN=https://sparks.example.com

MICROSOFT_AUTH_ENABLED=true
MICROSOFT_TENANT_ID=CHANGE_ME
MICROSOFT_CLIENT_ID=CHANGE_ME
MICROSOFT_CLIENT_SECRET=CHANGE_ME_SECRET_VALUE_NOT_SECRET_ID
MICROSOFT_REDIRECT_URI=https://sparks.example.com/api/v1/auth/microsoft/callback

MAIL_ENABLED=true
MAIL_SENDER_EMAIL=cjn-sparks@c-job.com.ua
MAIL_SENDER_USER_ID=CHANGE_ME_SHARED_MAILBOX_OBJECT_ID_OR_REAL_UPN
MAIL_SENDER_NAME=C-Job Sparks
MAIL_WORKER_INTERVAL_MS=5000
MAIL_MAX_ATTEMPTS=5
MAIL_BATCH_SIZE=10
