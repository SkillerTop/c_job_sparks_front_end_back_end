NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# PostgreSQL 15+; application data is stored in the `app` schema.
DATABASE_URL=postgresql://c_job_sparks:local-development-only@127.0.0.1:5432/c_job_sparks
DATABASE_SSL=disable
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
MIGRATIONS_DIR=./migrations
MEDIA_ROOT=./data/media

# Use at least 32 random characters. Rotate through an explicit secret-management process.
COOKIE_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=c_job_sparks_session
SESSION_TTL_HOURS=168
TRUST_PROXY=false

# Comma-separated exact browser origins; never use * with credentialed requests.
CORS_ORIGINS=http://localhost:5173
