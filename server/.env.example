NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/c_job_sparks
DATABASE_SSL=disable
COOKIE_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

MICROSOFT_AUTH_ENABLED=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/v1/auth/microsoft/callback

# Uses the same Entra application credentials with Microsoft Graph
# Application permission Mail.Send and tenant administrator consent.
MAIL_ENABLED=false
MAIL_SENDER_EMAIL=cjn-sparks@c-job.com.ua
# Optional: set the mailbox Entra Object ID or UPN when its SMTP address is only an alias.
MAIL_SENDER_USER_ID=
MAIL_SENDER_NAME=C-Job Sparks
MAIL_WORKER_INTERVAL_MS=5000
MAIL_MAX_ATTEMPTS=5
MAIL_BATCH_SIZE=10
