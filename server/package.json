{
  "name": "c-job-sparks-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test --test-isolation=none dist/test/app-contract.test.js dist/test/domain.test.js dist/test/mail.test.js dist/test/media.test.js dist/test/migrations.test.js dist/test/schema-contract.test.js",
    "test:integration": "tsc -p tsconfig.json && node --env-file-if-exists=.env --test --test-isolation=none dist/test/postgres-integration.test.js",
    "test:all": "pnpm test && pnpm test:integration",
    "migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts up",
    "migrate:status": "node --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts status",
    "seed:dev": "node --env-file-if-exists=.env --import tsx src/db/seed.ts",
    "optimize:images": "node scripts/optimize-public-images.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "argon2": "^0.44.0",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
