# Keep "demo" for the self-contained browser version.
# Set to "api" to use the included Fastify/PostgreSQL backend.
VITE_APP_MODE=demo
VITE_SHOP_MODE=demo

# Backend origin in API mode, for example http://localhost:3001.
VITE_API_BASE_URL=

# For GitHub Pages use /repository-name/. Keep / for normal hosting.
VITE_BASE_PATH=/
