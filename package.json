{
  "name": "c-job-sparks-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --configLoader native",
    "dev:server": "pnpm --dir server dev",
    "build": "tsc --noEmit && vite build --configLoader native",
    "build:server": "pnpm --dir server build",
    "build:all": "pnpm build && pnpm build:server",
    "preview": "vite preview --configLoader native",
    "lint": "tsc --noEmit && eslint src server/src server/test tests e2e scripts *.ts && stylelint \"src/**/*.css\"",
    "lint:types": "tsc --noEmit",
    "lint:eslint": "eslint src server/src server/test tests e2e scripts *.ts --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "node --import ./tests/register.mjs --test --test-isolation=none tests/architecture.test.mjs tests/domain.test.mjs tests/auth.test.mjs tests/shop-demo.test.mjs tests/localization.test.mjs tests/rules-categories.test.mjs",
    "test:localization": "node scripts/audit-localization.mjs --check && node --import ./tests/register.mjs --test --test-isolation=none tests/localization.test.mjs",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun",
    "test:staging:mail": "node scripts/verify-graph-mail.mjs",
    "verify:production-bundle": "node scripts/assert-production-bundle.mjs",
    "test:server": "pnpm --dir server test",
    "migrate": "pnpm --dir server migrate"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "stylelint": "^17.16.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.3"
  }
}
